server {
    listen PLOTTER_PORT ssl;
    server_name PLOTTER_HOST;
    ssl_certificate /etc/plotter/tls/fullchain.pem;
    ssl_certificate_key /etc/plotter/tls/privkey.pem;
    client_max_body_size 128m;
    # PLOTTER_ORIGIN is the configured HTTPS origin without a trailing slash.
    error_page 497 =308 PLOTTER_ORIGIN$request_uri;

    location / {
        include /etc/nginx/plotter/upstream.conf;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering on;
        proxy_connect_timeout 2s;
        proxy_read_timeout 120s;
    }
}
